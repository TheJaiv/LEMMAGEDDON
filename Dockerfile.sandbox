# The sandbox: runs the agent's tools. No internet access (see docker-compose.yml).
FROM python:3.12-slim
RUN useradd --create-home --uid 1000 sandbox \
 && mkdir /workspace && chown sandbox:sandbox /workspace
COPY sandbox/server.py /opt/sandbox/server.py
USER sandbox
WORKDIR /workspace
ENV PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["python", "/opt/sandbox/server.py"]
